# MongoDB Atlas Connection URI
MONGO_URI=mongodb+srv://<user>:<pass>@<cluster>/<db>

# JWT Authentication
JWT_ACCESS_SECRET=your_jwt_access_secret_min_32_characters_long_for_security
JWT_REFRESH_SECRET=your_jwt_refresh_secret_min_32_characters_long_for_security

# Media Storage
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=5242880

# Application Port
PORT=3000
